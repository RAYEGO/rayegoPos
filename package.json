{
  "name": "pos-botica",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/run-with-project-env.mjs -- vite",
    "dev:prod-local": "node scripts/run-with-project-env.mjs --env production -- vite",
    "build": "node scripts/run-with-project-env.mjs -- npm run build:app",
    "build:prod-local": "node scripts/run-with-project-env.mjs --env production -- npm run build:app",
    "build:app": "tsc -b && vite build",
    "build:server": "node scripts/run-with-project-env.mjs -- tsc -p tsconfig.server.json",
    "build:server:prod-local": "node scripts/run-with-project-env.mjs --env production -- tsc -p tsconfig.server.json",
    "build:server:railway": "tsc -p tsconfig.server.json",
    "dev:server": "node scripts/run-with-project-env.mjs -- tsx watch server/src/index.ts",
    "dev:server:prod-local": "node scripts/run-with-project-env.mjs --env production -- tsx watch server/src/index.ts",
    "start:server": "node server/dist/index.js",
    "start:server:dev": "node scripts/run-with-project-env.mjs --env development -- node server/dist/index.js",
    "start:server:prod-local": "node scripts/run-with-project-env.mjs --env production -- node server/dist/index.js",
    "start:railway": "npm run start:server",
    "railway:build": "npm run prisma:generate:railway && npm run build:server:railway",
    "lint": "oxlint",
    "preview": "node scripts/run-with-project-env.mjs -- vite preview",
    "preview:prod-local": "node scripts/run-with-project-env.mjs --env production -- vite preview",
    "env:current": "node scripts/run-with-project-env.mjs --print",
    "env:current:prod-local": "node scripts/run-with-project-env.mjs --env production --print",
    "prisma:format": "node scripts/run-with-project-env.mjs -- prisma format",
    "prisma:validate": "node scripts/run-with-project-env.mjs -- prisma validate",
    "prisma:validate:prod-local": "node scripts/run-with-project-env.mjs --env production -- prisma validate",
    "prisma:generate": "node scripts/run-with-project-env.mjs -- prisma generate",
    "prisma:generate:prod-local": "node scripts/run-with-project-env.mjs --env production -- prisma generate",
    "prisma:generate:railway": "prisma generate",
    "prisma:migrate:dev": "node scripts/run-with-project-env.mjs -- prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:deploy:prod-local": "node scripts/run-with-project-env.mjs --env production -- prisma migrate deploy",
    "prisma:migrate:status": "node scripts/run-with-project-env.mjs -- prisma migrate status",
    "prisma:migrate:status:prod-local": "node scripts/run-with-project-env.mjs --env production -- prisma migrate status",
    "prisma:seed": "node scripts/run-with-project-env.mjs -- tsx prisma/seed.ts",
    "prisma:seed:prod-local": "node scripts/run-with-project-env.mjs --env production -- tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.0",
    "@fontsource/inter": "^5.2.8",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@types/node": "^24.13.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.10.0",
    "jspdf": "^3.0.3",
    "lucide-react": "^1.24.0",
    "papaparse": "^5.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-router-dom": "^7.18.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "dotenv": "^17.4.2",
    "dotenv": "^17.2.2",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.18",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
