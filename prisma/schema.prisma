/// Módulo: Configuración
model Configuracion {
  id            String              @id @default(uuid()) @db.Uuid
  empresaId     String              @map("empresa_id") @db.Uuid
  sucursalId    String?             @map("sucursal_id") @db.Uuid
  ambito        AmbitoConfiguracion
  clave         String              @db.VarChar(120)
  valorTexto    String?             @map("valor_texto") @db.VarChar(500)
  valorNumero   Decimal?            @map("valor_numero") @db.Decimal(18, 4)
  valorBooleano Boolean?            @map("valor_booleano")
  valorJson     Json?               @map("valor_json")
  descripcion   String?             @db.VarChar(255)
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  deletedAt     DateTime?           @map("deleted_at")
  createdById   String?             @map("created_by") @db.Uuid
  updatedById   String?             @map("updated_by") @db.Uuid
  createdBy     Usuario?            @relation("ConfiguracionCreatedBy", fields: [createdById], references: [id])
  empresa       Empresa             @relation(fields: [empresaId], references: [id])
  sucursal      Sucursal?           @relation(fields: [sucursalId], references: [id])
  updatedBy     Usuario?            @relation("ConfiguracionUpdatedBy", fields: [updatedById], references: [id])

  @@unique([empresaId, sucursalId, ambito, clave])
  @@index([clave])
  @@index([deletedAt])
  @@map("configuracion")
}

model SerieDocumento {
  id              String          @id @default(uuid()) @db.Uuid
  empresaId       String          @map("empresa_id") @db.Uuid
  sucursalId      String?         @map("sucursal_id") @db.Uuid
  tipoComprobante TipoComprobante @map("tipo_comprobante")
  serie           String          @db.VarChar(20)
  siguienteNumero Int             @default(1) @map("siguiente_numero")
  longitudNumero  Int             @default(8) @map("longitud_numero")
  activo          Boolean         @default(true)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")
  createdById     String?         @map("created_by") @db.Uuid
  updatedById     String?         @map("updated_by") @db.Uuid
  createdBy       Usuario?        @relation("SerieDocumentoCreatedBy", fields: [createdById], references: [id])
  empresa         Empresa         @relation(fields: [empresaId], references: [id])
  sucursal        Sucursal?       @relation(fields: [sucursalId], references: [id])
  updatedBy       Usuario?        @relation("SerieDocumentoUpdatedBy", fields: [updatedById], references: [id])
  ventas          Venta[]

  @@unique([empresaId, sucursalId, tipoComprobante, serie])
  @@index([tipoComprobante, activo])
  @@index([deletedAt])
  @@map("series_documentos")
}

model Impuesto {
  id               String             @id @default(uuid()) @db.Uuid
  empresaId        String             @map("empresa_id") @db.Uuid
  codigo           String             @db.VarChar(30)
  nombre           String             @db.VarChar(120)
  tipo             TipoImpuesto
  porcentaje       Decimal            @db.Decimal(7, 4)
  incluidoEnPrecio Boolean            @default(false) @map("incluido_en_precio")
  activo           Boolean            @default(true)
  vigenteDesde     DateTime           @map("vigente_desde") @db.Date
  vigenteHasta     DateTime?          @map("vigente_hasta") @db.Date
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  deletedAt        DateTime?          @map("deleted_at")
  createdById      String?            @map("created_by") @db.Uuid
  updatedById      String?            @map("updated_by") @db.Uuid
  createdBy        Usuario?           @relation("ImpuestoCreatedBy", fields: [createdById], references: [id])
  empresa          Empresa            @relation(fields: [empresaId], references: [id])
  updatedBy        Usuario?           @relation("ImpuestoUpdatedBy", fields: [updatedById], references: [id])
  productos        ProductoImpuesto[]

  @@unique([empresaId, codigo])
  @@index([tipo, activo])
  @@index([deletedAt])
  @@map("impuestos")
}

/// Módulo: Auditoría
model Auditoria {
  id            String          @id @default(uuid()) @db.Uuid
  usuarioId     String?         @map("usuario_id") @db.Uuid
  tabla         String          @db.VarChar(120)
  registroId    String?         @map("registro_id") @db.Uuid
  accion        AccionAuditoria
  fechaEvento   DateTime        @default(now()) @map("fecha_evento")
  valorAnterior Json?           @map("valor_anterior")
  valorNuevo    Json?           @map("valor_nuevo")
  direccionIp   String?         @map("direccion_ip") @db.VarChar(45)
  userAgent     String?         @map("user_agent") @db.VarChar(255)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  deletedAt     DateTime?       @map("deleted_at")
  createdById   String?         @map("created_by") @db.Uuid
  updatedById   String?         @map("updated_by") @db.Uuid
  createdBy     Usuario?        @relation("AuditoriaCreatedBy", fields: [createdById], references: [id])
  updatedBy     Usuario?        @relation("AuditoriaUpdatedBy", fields: [updatedById], references: [id])
  usuario       Usuario?        @relation("AuditoriaActor", fields: [usuarioId], references: [id])

  @@index([usuarioId, fechaEvento])
  @@index([tabla, fechaEvento])
  @@index([registroId])
  @@index([deletedAt])
  @@map("auditoria")
}

