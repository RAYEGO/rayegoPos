  compraPresentacion             Presentacion?                   @relation("ProductoCompraPresentacion", fields: [compraPresentacionId], references: [id], onDelete: Restrict)
  createdBy                      Usuario?                        @relation("ProductoCreatedBy", fields: [createdById], references: [id])
  empresa                        Empresa                         @relation(fields: [empresaId], references: [id])
  laboratorio                    Laboratorio?                    @relation(fields: [laboratorioId], references: [id], onDelete: Restrict)
  presentacion                   Presentacion?                   @relation(fields: [presentacionId], references: [id], onDelete: Restrict)
  principioActivo                PrincipioActivo?                @relation("ProductoPrincipioActivoPrincipal", fields: [principioActivoId], references: [id], onDelete: Restrict)
  tipoComercial                  TipoComercial?                  @relation(fields: [tipoComercialId], references: [id], onDelete: Restrict)
