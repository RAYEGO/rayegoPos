  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")
  deletedAt              DateTime?    @map("deleted_at")
  createdById            String?      @map("created_by") @db.Uuid
  updatedById            String?      @map("updated_by") @db.Uuid
  aperturaCaja           AperturaCaja @relation(fields: [aperturaCajaId], references: [id])
  createdBy              Usuario?     @relation("ArqueoCajaCreatedBy", fields: [createdById], references: [id])
  updatedBy              Usuario?     @relation("ArqueoCajaUpdatedBy", fields: [updatedById], references: [id])
  usuario                Usuario      @relation("ArqueoCajaUsuario", fields: [usuarioId], references: [id])

  @@index([aperturaCajaId, fechaArqueo])
  @@index([usuarioId, fechaArqueo])
  @@index([deletedAt])
  @@map("arqueo_caja")
}

model CierreCaja {
