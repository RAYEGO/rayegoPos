  observaciones                  String?                         @db.VarChar(255)
  createdAt                      DateTime                        @default(now()) @map("created_at")
  updatedAt                      DateTime                        @updatedAt @map("updated_at")
  deletedAt                      DateTime?                       @map("deleted_at")
  createdById                    String?                         @map("created_by") @db.Uuid
  updatedById                    String?                         @map("updated_by") @db.Uuid
  stockBloqueado                 Int                             @default(0) @map("stock_bloqueado")
  compraRecepcionId              String?                         @map("compra_recepcion_id") @db.Uuid
  cargasInventarioInicialDetalle CargaInventarioInicialDetalle[]
  detalleVentaLotes              DetalleVentaLote[]
  compraRecepcion                CompraRecepcion?                @relation(fields: [compraRecepcionId], references: [id])
  createdBy                      Usuario?                        @relation("LoteCreatedBy", fields: [createdById], references: [id])
  detalleCompra                  DetalleCompra?                  @relation(fields: [detalleCompraId], references: [id])
  producto                       Producto                        @relation(fields: [productoId], references: [id])
  proveedor                      Proveedor?                      @relation(fields: [proveedorId], references: [id])
  sucursal                       Sucursal                        @relation(fields: [sucursalId], references: [id])
  updatedBy                      Usuario?                        @relation("LoteUpdatedBy", fields: [updatedById], references: [id])
  movimientosInventario          MovimientoInventario[]

  @@unique([sucursalId, productoId, numeroLote])
  @@index([productoId, fechaVencimiento])
  @@index([sucursalId, fechaVencimiento])
  @@index([compraRecepcionId])
  @@index([stockDisponible])
  @@index([deletedAt])
  @@map("lotes")
}

