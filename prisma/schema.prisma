  fechaVencimiento               DateTime                        @map("fecha_vencimiento") @db.Date
  costoUnitario                  Decimal                         @map("costo_unitario") @db.Decimal(14, 6)
  stockInicial                   Int                             @default(0) @map("stock_inicial")
  stockDisponible                Int                             @default(0) @map("stock_disponible")
  stockReservado                 Int                             @default(0) @map("stock_reservado")
