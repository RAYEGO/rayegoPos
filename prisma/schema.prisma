  empresaId                      String                          @map("empresa_id") @db.Uuid
  compraPresentacionId           String?                         @map("compra_presentacion_id") @db.Uuid
  tipoComercialId                String?                         @map("tipo_comercial_id") @db.Uuid
  principioActivoId              String?                         @map("principio_activo_id") @db.Uuid
  cargasInventarioInicialDetalle CargaInventarioInicialDetalle[]
