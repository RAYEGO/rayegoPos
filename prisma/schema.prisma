  montoDeclaradoEfectivo Decimal      @default(0) @map("monto_declarado_efectivo") @db.Decimal(14, 2)
  diferenciaEfectivo     Decimal      @default(0) @map("diferencia_efectivo") @db.Decimal(14, 2)
  observaciones          String?      @db.VarChar(255)
