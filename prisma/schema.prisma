/// Libro de caja consolidado para ingresos, egresos y ventas.
model MovimientoCaja {
  id              String             @id @default(uuid()) @db.Uuid
  aperturaCajaId  String             @map("apertura_caja_id") @db.Uuid
  formaPagoId     String?            @map("forma_pago_id") @db.Uuid
  ventaPagoId     String?            @map("venta_pago_id") @db.Uuid
  tipo            TipoMovimientoCaja
  operacion       OperacionCaja
  fechaMovimiento DateTime           @default(now()) @map("fecha_movimiento")
  monto           Decimal            @db.Decimal(14, 2)
  saldoResultante Decimal?           @map("saldo_resultante") @db.Decimal(14, 2)
  referencia      String?            @db.VarChar(120)
  observaciones   String?            @db.VarChar(255)
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  deletedAt       DateTime?          @map("deleted_at")
  createdById     String?            @map("created_by") @db.Uuid
  updatedById     String?            @map("updated_by") @db.Uuid
  egreso          Egreso?
  ingreso         Ingreso?
  aperturaCaja    AperturaCaja       @relation(fields: [aperturaCajaId], references: [id])
  createdBy       Usuario?           @relation("MovimientoCajaCreatedBy", fields: [createdById], references: [id])
  formaPago       FormaPago?         @relation(fields: [formaPagoId], references: [id])
  updatedBy       Usuario?           @relation("MovimientoCajaUpdatedBy", fields: [updatedById], references: [id])
  ventaPago       VentaPago?         @relation(fields: [ventaPagoId], references: [id])

  @@index([aperturaCajaId, fechaMovimiento])
  @@index([formaPagoId])
  @@index([ventaPagoId])
  @@index([deletedAt])
  @@map("movimientos_caja")
}

model Ingreso {
  id               String         @id @default(uuid()) @db.Uuid
  movimientoCajaId String         @unique @map("movimiento_caja_id") @db.Uuid
  concepto         String         @db.VarChar(120)
  referencia       String?        @db.VarChar(120)
  observaciones    String?        @db.VarChar(255)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  deletedAt        DateTime?      @map("deleted_at")
  createdById      String?        @map("created_by") @db.Uuid
  updatedById      String?        @map("updated_by") @db.Uuid
  createdBy        Usuario?       @relation("IngresoCreatedBy", fields: [createdById], references: [id])
  movimientoCaja   MovimientoCaja @relation(fields: [movimientoCajaId], references: [id])
  updatedBy        Usuario?       @relation("IngresoUpdatedBy", fields: [updatedById], references: [id])

  @@index([concepto])
  @@index([deletedAt])
  @@map("ingresos")
}

model Egreso {
  id               String         @id @default(uuid()) @db.Uuid
