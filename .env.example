## Rayego POS - Variables de entorno de referencia
#
# Estrategia local automática:
# - rama main/master -> .env.production
# - rama develop -> .env.development
# - cualquier otra rama local -> .env.development
#
# Regla de URLs:
# - DATABASE_URL -> runtime y trafico pooled
# - DIRECT_URL   -> Prisma CLI (migrate, db pull, db push, studio)
#
# Railway y Vercel NO deben depender de archivos .env del repositorio.
# Ambos deben usar exclusivamente sus variables configuradas en la plataforma.

APP_ENV=""
DATABASE_URL=""
DIRECT_URL=""

# Backend
JWT_SECRET=""
PORT=4000
HOST="0.0.0.0"
FRONTEND_ORIGIN=""

# Frontend
VITE_API_BASE_URL=""
VITE_PROXY_API_TARGET=""
VITE_AUTH_ALLOW_MOCKS="false"

# Supabase Storage
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
